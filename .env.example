# Copy this file to .env to override configuration locally.
#
# These are the same values as the defaults in app/config.py, so a fresh clone needs
# no .env at all. Set a variable here (or export it in your shell) only when you need
# something different; environment variables take precedence over this file.
#
# The DSNs carry no user or password on purpose: libpq falls back to your operating
# system user, which keeps the repository runnable without editing anything.

# Development database.
# DATABASE_URL=postgresql+psycopg://localhost:5432/softtek_assessment

# Test database. The test suite drops and recreates the public schema on every run,
# so never point this at the same database as DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/softtek_assessment_test
