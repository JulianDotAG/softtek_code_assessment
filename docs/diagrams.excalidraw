      "link": null,
      "locked": false,
      "text": "Code   |   Message                                                              |   Type\n----------------------------------------------------------------------\n422     |   Field required                                                      |   missing\n422     |   String should have at least 1 character           |    string_too_short\n422     |   String should have at most 200 characters    |    string_too_long\n422     |   Input should be greater than 0                         |    greater_than\n422     |   Input should be a valid integer                         |    int_parsing\n422     |   value is not a valid email address:                   |    value_error\n404     |   Not Found                                                           |    routing de Starlette\n405     |   Method Not Allowed                                         |    routing de Starlette\n500        (sin cuerpo, traceback en el log) ",
      "fontSize": 28,
      "baseFontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
