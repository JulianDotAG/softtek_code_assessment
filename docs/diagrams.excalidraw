      "link": null,
      "locked": false,
      "text": "amount and service_description are a snapshot taken when the order is created\nfolio comes from order_folio_seq. \nPostgreSQL sequence that starts at 1000\ncancelled_at NULL means the order is still active",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "note",
      "originalText": "amount and service_description are a snapshot taken when the order is created\nfolio comes from order_folio_seq. \nPostgreSQL sequence that starts at 1000\ncancelled_at NULL means the order is still active",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
